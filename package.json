{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "xlate",
  "title": "Xlate",
  "description": "AI-powered translator for 133 languages. Works with any OpenAI-compatible API — OpenRouter, OpenAI, Gemini, Claude, Mistral, Groq, DeepSeek, Ollama, LM Studio, and more. Streaming translations, tone selection, proofreading, and history.",
  "icon": "extension-icon.png",
  "author": "nargit21",
  "keywords": [
    "translate",
    "translation",
    "translator",
    "ai",
    "language",
    "openai",
    "openrouter",
    "llm",
    "proofread",
    "grammar",
    "gemini",
    "claude",
    "ollama",
    "deepseek",
    "mistral",
    "groq"
  ],
  "categories": [
    "Productivity",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "translate",
      "title": "Translate",
      "subtitle": "xlate",
      "description": "Translate text between languages using AI",
      "mode": "view",
      "keywords": ["translate", "translation", "ai", "language", "convert"],
      "arguments": [
        {
          "name": "text",
          "placeholder": "Text to translate",
          "type": "text",
          "required": false
        }
      ],
      "preferences": [
        {
          "name": "translationTone",
          "type": "dropdown",
          "title": "Translation Tone",
          "description": "Default tone/style for translations",
          "required": false,
          "default": "natural",
          "data": [
            {
              "title": "Natural",
              "value": "natural"
            },
            {
              "title": "Formal",
              "value": "formal"
            },
            {
              "title": "Casual",
              "value": "casual"
            },
            {
              "title": "Technical",
              "value": "technical"
            },
            {
              "title": "Literary",
              "value": "literary"
            },
            {
              "title": "Business",
              "value": "business"
            }
          ]
        }
      ]
    },
    {
      "name": "translate-selected",
      "title": "Translate Selected Text",
      "subtitle": "xlate",
      "description": "Translate the currently selected text",
      "mode": "view",
      "keywords": ["translate", "translation", "selected", "ai"]
    },
    {
      "name": "translate-clipboard",
      "title": "Translate Clipboard",
      "subtitle": "xlate",
      "description": "Translate text from clipboard",
      "mode": "view",
      "keywords": ["translate", "translation", "clipboard", "paste"]
    },
    {
      "name": "quick-translate",
      "title": "Quick Translate",
      "subtitle": "xlate",
      "description": "Translate selected text and copy result to clipboard",
      "mode": "no-view",
      "keywords": ["translate", "quick", "fast", "copy"]
    },
    {
      "name": "history",
      "title": "Translation History",
      "subtitle": "xlate",
      "description": "Browse past translations",
      "mode": "view",
      "keywords": ["history", "translate", "past", "saved"]
    },
    {
      "name": "proofread",
      "title": "Proofread & Improve",
      "subtitle": "xlate",
      "description": "Improve grammar and style of selected text using AI",
      "mode": "view",
      "keywords": ["proofread", "grammar", "improve", "writing", "ai"]
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "type": "password",
      "title": "API Key",
      "description": "API key for OpenRouter, OpenAI, or other compatible provider. Leave empty for local models (Ollama, LM Studio)",
      "required": false
    },
    {
      "name": "apiBaseUrl",
      "type": "textfield",
      "title": "API Base URL",
      "description": "API endpoint (e.g. https://openrouter.ai/api/v1, https://api.openai.com/v1, http://localhost:11434/v1)",
      "required": false,
      "default": "https://openrouter.ai/api/v1"
    },
    {
      "name": "model",
      "type": "textfield",
      "title": "Model",
      "description": "Model identifier (e.g. moonshotai/kimi-k2.5, gpt-4o, llama3)",
      "required": false,
      "default": "moonshotai/kimi-k2.5"
    },
